# Copy this file to .env and fill in the values. .env is git-ignored - never commit it.

# Google AI Studio key (https://aistudio.google.com/apikey) - used for both the LLM and embeddings
LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash
# LLM_FAST_MODEL=gemini-3.5-flash-lite

# Embeddings: local (default; bge-small-en-v1.5 on CPU, no key/quota) or gemini (uses the key below)
# EMBED_PROVIDER=local

# Optional: separate key for Gemini embeddings (defaults to LLM_API_KEY)
# EMBED_API_KEY=
# EMBED_MAX_RPM=100   # texts per minute; set on the Gemini free tier, 0 = no throttle

# Vector store: leave empty for local on-disk Qdrant; set for Qdrant Cloud (deployment)
# QDRANT_URL=
# QDRANT_API_KEY=

# Required for write endpoints (upload/delete) on the public demo
ADMIN_TOKEN=
